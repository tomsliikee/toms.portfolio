---
import Base from '../../layouts/Base.astro';
import Turtle from '../../components/Turtle.astro';
import NextLink from '../../components/NextLink.astro';
import { pagesNav, projectFloat } from '../../lib/nav';
---
<Base
  page="pulse"
  title="Pulse – Thomas Haiden"
  description="Health app, built with Flutter. Toms Expressive Design is based on its look."
  nav={pagesNav}
  navFloat={projectFloat('/projects/gnome')}
>
<div class="split">
<Turtle mode="detail" />
<main id="main" class="col" style="padding-bottom: 0">
<p class="kick in d1"><span class="num">04 / 04</span><span>Health app, Flutter</span></p>
<h1 class="hx wipe d2">Pulse</h1>
<p class="lede in d3">Health app, built with Flutter. Toms Expressive Design is based on its look.</p>
<svg class="ecg in d4" viewBox="0 0 560 64" aria-hidden="true"><path d="M0 40 H170 L190 40 L200 12 L212 58 L224 26 L232 40 H330 L346 40 L356 4 L368 62 L380 22 L388 40 H560"></path></svg>
<dl class="facts in d4">
<div><dt>Type</dt><dd>Health app, personal project</dd></div>
<div><dt>Stack</dt><dd>Flutter</dd></div>
<div><dt>Status</dt><dd>Beta, released on GitHub</dd></div>
<div><dt>Source</dt><dd><a class="ul" href="https://github.com/tomsliikee/pulse">github.com/tomsliikee/pulse</a></dd></div>
</dl>

<section class="sec">
<p class="sec-h sr"><span class="num">(1)</span>Overview</p>
<div>
<p class="todo sr">[The core features of Pulse]</p>
</div>
</section>

<section class="sec">
<p class="sec-h sr"><span class="num">(2)</span>Road to release</p>
<div class="steps">
<div class="step now sr"><span class="num">Now</span><div><p class="t">Beta on GitHub</p><p>The first beta is a GitHub release.</p></div></div>
<div class="step sr"><span class="num">Next</span><div><p class="t">Play Store</p><p>The full version on the Play Store.</p></div></div>
<div class="step sr"><span class="num">Planned</span><div><p class="t">Premium</p><p>A premium version alongside the free app.</p></div></div>
</div>
</section>

<section class="sec">
<p class="sec-h sr"><span class="num">(3)</span>On the screen</p>
<div class="shots">
<figure class="shot sr"><img src="/img/pulse/today.webp" width="1760" height="943" loading="lazy" decoding="async" alt="Four Pulse screens: Today with goals, steps and heart rate, the day in detail with the recovery score, the day in numbers, and the list of all days."><figcaption class="num">Today</figcaption></figure>
<figure class="shot sr"><img src="/img/pulse/heart.webp" width="1760" height="943" loading="lazy" decoding="async" alt="Four Pulse screens about heart rate: the curve over the day, time in zones, heart rate in detail and the parts of the day."><figcaption class="num">Heart</figcaption></figure>
<figure class="shot sr"><img src="/img/pulse/sleep.webp" width="1760" height="943" loading="lazy" decoding="async" alt="Four Pulse screens about sleep: tonight's bedtime and sleep stages, the sleep score, the night in numbers and the stages compared."><figcaption class="num">Sleep</figcaption></figure>
</div>
</section>

<section class="sec">
<p class="sec-h sr"><span class="num">(4)</span>Introduction</p>
<div>
<p class="body sr">Pulse will be introduced with a post in the Google Health, Google Pixel and Fitbit communities.</p>
</div>
</section>

<NextLink href="/projects" label="All projects" title="Back to projects" />
</main>
</div>
</Base>

<style is:global>
  [data-page="pulse"] .ecg { display: block; width: 100%; max-width: 560px; height: 64px; margin: 48px 0 0 var(--indent); overflow: visible }
  [data-page="pulse"] .ecg path { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 900; stroke-dashoffset: 900; animation: trace 3.2s var(--ease) 1s infinite }
  [data-page="pulse"] .steps { border-top: 1px solid var(--line) }
  [data-page="pulse"] .step { display: grid; grid-template-columns: 90px minmax(0, 1fr); gap: 20px; padding: 22px 0; border-bottom: 1px solid var(--line) }
  [data-page="pulse"] .step .t { font-family: var(--font-serif); font-size: clamp(28px, 2.8vw, 40px); line-height: 1; letter-spacing: -.035em; margin: 0 0 8px }
  [data-page="pulse"] .step p { margin: 0; font-size: 16px; line-height: 1.65 }
  [data-page="pulse"] .step.now .num::before { content: ""; display: inline-block; width: 8px; height: 8px; background: var(--accent); margin-right: 8px; animation: blink 1.2s steps(1) infinite }
  @keyframes trace { 0% { stroke-dashoffset: 900 } 60% { stroke-dashoffset: 0 } 100% { stroke-dashoffset: -900 } }
  @media (max-width: 860px) {
    [data-page="pulse"] .ecg { margin-left: 0 }
    [data-page="pulse"] .step { grid-template-columns: 70px minmax(0, 1fr) }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-page="pulse"] .ecg path { animation: none; stroke-dashoffset: 0 }
    [data-page="pulse"] .step.now .num::before { animation: none }
  }
</style>
